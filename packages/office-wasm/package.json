{
  "name": "office-wasm",
  "version": "0.1.0",
  "private": true,
  "description": "Обёртка над LibreOffice WASM: инициализация офисного движка и конвертация документов в PDF в браузере",
  "type": "module",
  "main": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "import": "./index.ts",
      "default": "./index.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "E2E=1 vitest run strip-print-ranges.e2e.test.ts"
  },
  "dependencies": {
    "@matbee/libreoffice-converter": "^2.7.2",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
